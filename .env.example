# ── Identity ──────────────────────────────────────────────────────────────
STORE_ID=store_001
CAMERA_ID=cam_01

# ── Pipeline ──────────────────────────────────────────────────────────────
# Mode: live | replay
PIPELINE_MODE=replay

# Video file path (LIVE mode)
VIDEO_PATH=data/sample.mp4

# Pre-recorded events file (REPLAY mode)
EVENTS_JSONL_PATH=data/events.jsonl

# Process every Nth frame
FRAME_SKIP=5

# Replay speed multiplier (1.0 = real-time, 2.0 = 2x speed)
REPLAY_SPEED_MULTIPLIER=1.0

# ── YOLOv8 Detection ──────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.4
DEVICE=cpu

# ── Zone & Line Configuration ─────────────────────────────────────────────
ZONES_CONFIG_PATH=config/zones.yaml

# Virtual crossing line Y position (normalised 0-1)
# Centroids above this line = inside store, below = outside
ENTRY_LINE_Y=0.4

# ── Session Management ────────────────────────────────────────────────────
SESSION_REENTRY_WINDOW_SECONDS=1800
DWELL_EVENT_INTERVAL_SECONDS=30
TRACK_LOST_TIMEOUT_SECONDS=5

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=fluxretail.events
KAFKA_METRICS_TOPIC=fluxretail.metrics
KAFKA_ALERTS_TOPIC=fluxretail.alerts
KAFKA_PRODUCER_TIMEOUT_SECONDS=30

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=fluxretail
POSTGRES_USER=fluxretail
POSTGRES_PASSWORD=fluxretail_secret
DATABASE_URL=postgresql+asyncpg://fluxretail:fluxretail_secret@localhost:5432/fluxretail

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Health monitoring
HEALTH_STALE_FEED_TIMEOUT_SECONDS=60
HEALTH_PIPELINE_HEARTBEAT_TIMEOUT_SECONDS=30

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
