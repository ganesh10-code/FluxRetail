# FluxRetail Pipeline Service — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.

# ── Identity ─────────────────────────────────────────────────────────────────
STORE_ID=store_001
CAMERA_ID=cam_01

# ── Pipeline mode ─────────────────────────────────────────────────────────────
# live   = process video frames with YOLOv8 + ByteTrack in real time
# replay = read data/events.jsonl and re-publish to Kafka at original cadence
PIPELINE_MODE=replay

# ── Video / replay paths ──────────────────────────────────────────────────────
VIDEO_PATH=data/sample.mp4
EVENTS_JSONL_PATH=data/events.jsonl

# ── Frame sampling (LIVE mode) ────────────────────────────────────────────────
# Process every Nth frame. 5 = process every 5th frame (~5fps from 25fps source)
FRAME_SKIP=5

# ── YOLOv8 detection ──────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE=0.4
# Use 'cuda' if a GPU is available, otherwise 'cpu'
DEVICE=cpu

# ── Zone configuration ────────────────────────────────────────────────────────
ZONES_CONFIG_PATH=config/zones.yaml

# ── Virtual crossing line ─────────────────────────────────────────────────────
# Normalised Y position (0.0 = top, 1.0 = bottom) of the entry/exit line
ENTRY_LINE_Y=0.4

# ── Session management ────────────────────────────────────────────────────────
# Seconds within which a reappearing track is treated as re-entry (30 min)
SESSION_REENTRY_WINDOW_SECONDS=1800
# Emit a ZONE_DWELL event every N seconds a visitor stays in a zone
DWELL_EVENT_INTERVAL_SECONDS=30
# Seconds before a lost track is considered exited
TRACK_LOST_TIMEOUT_SECONDS=5

# ── Redis (pipeline heartbeat) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=fluxretail.events
KAFKA_METRICS_TOPIC=fluxretail.metrics
KAFKA_ALERTS_TOPIC=fluxretail.alerts
# Seconds to wait for Kafka on startup before aborting
KAFKA_PRODUCER_TIMEOUT_SECONDS=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json = structured JSON (production) | console = coloured human-readable (dev)
LOG_FORMAT=json

# ── Replay mode ───────────────────────────────────────────────────────────────
# 1.0 = real-time, 2.0 = 2x speed, 0.5 = half speed
REPLAY_SPEED_MULTIPLIER=1.0
