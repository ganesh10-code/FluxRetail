# FluxRetail API Service — environment variables
# Copy this file to .env and adjust values for your deployment.

# ── Identity ──────────────────────────────────────────────────────────────────
STORE_ID=store_001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fluxretail:fluxretail_secret@localhost:5432/fluxretail

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=fluxretail.events
KAFKA_CONSUMER_GROUP=fluxretail-api-consumer

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Health monitoring ─────────────────────────────────────────────────────────
# Seconds without a new Kafka event before /health reports STALE_FEED
HEALTH_STALE_FEED_TIMEOUT_SECONDS=60
# Seconds without a pipeline heartbeat before /health reports PIPELINE_STALE
HEALTH_PIPELINE_HEARTBEAT_TIMEOUT_SECONDS=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Use "json" for production, "console" for local development
LOG_FORMAT=json
